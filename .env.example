# LGTM settings. Copy this file to .env (same folder) and fill in the key:
#
#     cp .env.example .env
#
# .env is git-ignored: never commit it or put it in a zip.

# --- Required for live reviews -------------------------------------------------------------
# Amazon Bedrock API key (a long-term Bedrock key, not an Anthropic console key). With it, the
# reviewer and the evidence judge both run on Claude through Bedrock, so no GPU is needed.
# The SE201 team will send you one privately; it is never committed to the repository.
# The dashboard stops spending at USD 10 per machine (python demo/server.py --bedrock-allowance N).
AWS_BEDROCK_API_KEY=

# --- Optional ------------------------------------------------------------------------------
# Who owns your copies (forks) of the demo repositories. Leave empty: the dashboard uses the
# GitHub account that created your LGTM GitHub App on the setup page.
LGTM_DEMO_OWNER=

# Reviewer and judge for a fresh install (Settings in the dashboard can change them later).
# Leave empty to choose automatically: with the key above and no GPU job running, both use the API.
#   LGTM_REVIEWER = bedrock (Claude on Bedrock) | gpu (Qwen 3.8 27B through the SMU GPU tunnel)
#   LGTM_JUDGE    = claude (Claude stand-in judge) | kev (Kev-4B judge on 127.0.0.1:8008)
LGTM_REVIEWER=
LGTM_JUDGE=

# The small local model that writes code live in the Workspace ("Write it live"). Needs Ollama:
#   ollama pull llama3.2
# Without Ollama, use "Replay the prepared change instead"; the rest of the demo works the same.
LGTM_WRITER_MODEL=llama3.2:latest
