# Copy to model/.env and fill in. Account/partition/QOS come from `myinfo` on the login node.
ORIGAMI_USER=<smu-username>
ORIGAMI_HOST=10.193.104.102
ORIGAMI_SSH_KEY=~/.ssh/id_ed25519_origami

SLURM_ACCOUNT=se201
SLURM_PARTITION=student
SLURM_QOS=studentqos
NOTIFY_EMAIL=<username>@computing.smu.edu.sg

SCRATCH_DIR=/common/scratch/users/<initial>/<smu-username>
REMOTE_ROOT=llm-serve
PYTHON_MODULE=Python/3.11.11-GCCcore-13.3.0
OLLAMA_BIN=/common/public/ollama/bin/ollama

# Pulled into $SCRATCH_DIR/ollama-models. GPU slices are 24 GB (MIG 1g.24gb).
MODELS="qwen2.5:7b"
DEFAULT_MODEL=qwen2.5:7b
# Walltime of a serve job; studentqos caps jobs at 1-00:00:00.
SESSION_TIME=08:00:00

# Passed to `ollama serve`. -1 keeps the model in GPU memory for the whole job.
OLLAMA_KEEP_ALIVE=-1
# OLLAMA_CONTEXT_LENGTH=16384
# OLLAMA_NUM_PARALLEL=1

# 11434 is avoided so a local Ollama can keep running alongside the tunnel.
LOCAL_OLLAMA_PORT=11435
