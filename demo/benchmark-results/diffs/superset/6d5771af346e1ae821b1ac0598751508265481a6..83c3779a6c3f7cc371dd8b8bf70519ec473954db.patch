+from superset.jinja_context import where_in
+
+
+def test_where_in() -> None:
+    """
+    Test the ``where_in`` Jinja2 filter.
+    """
+    assert where_in([1, "b", 3]) == "(1, 'b', 3)"
+    assert where_in([1, "b", 3], '"') == '(1, "b", 3)'
+    assert where_in(["O'Malley's"]) == "('O''Malley''s')"
