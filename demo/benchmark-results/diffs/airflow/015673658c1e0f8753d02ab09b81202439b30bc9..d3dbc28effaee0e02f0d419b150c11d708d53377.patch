+    options: list[str],
+    subject: str,
+    body: str | None = None,
+    defaults: list[str] | None = None,
+    multiple: bool = False,
+    params: dict[str, Any] | None = None,
+) -> None:
+    from airflow.sdk.execution_time.task_runner import SUPERVISOR_COMMS
+
+    SUPERVISOR_COMMS.send(
+        msg=CreateHITLDetailPayload(
+            ti_id=ti_id,
+            options=options,
+            subject=subject,
+            body=body,
+            defaults=defaults,
+            params=params,
+            multiple=multiple,
+        )
+    )
+
+
+def update_htil_detail_response(
+    ti_id: UUID,
+    chosen_options: list[str],
+    params_input: dict[str, Any],
+) -> HITLDetailResponse:
+    from airflow.sdk.execution_time.task_runner import SUPERVISOR_COMMS
+
+    response = SUPERVISOR_COMMS.send(
+        msg=UpdateHITLDetail(
+            ti_id=ti_id,
+            chosen_options=chosen_options,
+            params_input=params_input,
+        ),
+    )
+    if TYPE_CHECKING:
+        assert isinstance(response, HITLDetailResponse)
+    return response
+
+
+def get_hitl_detail_content_detail(ti_id: UUID) -> HITLDetailResponse:
+    from airflow.sdk.execution_time.task_runner import SUPERVISOR_COMMS
+
+    response = SUPERVISOR_COMMS.send(msg=GetHITLDetailResponse(ti_id=ti_id))
+
+    if TYPE_CHECKING:
+        assert isinstance(response, HITLDetailResponse)
+    return response
