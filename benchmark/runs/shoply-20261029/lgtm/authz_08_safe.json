      "raw_answer": "{\n  \"sections\": [\n    {\n      \"id\": \"role-check-refactor\",\n      \"title\": \"Extract role-hierarchy comparison into role_below() and use it in require_role\",\n      \"rationale\": \"Both hunks implement a single access-control concern: the role-hierarchy comparison used by the require_role decorator. Hunk #0 introduces a new helper role_below() that encapsulates the ROLE_RANK comparison (ROLE_RANK.get(role,0) < ROLE_RANK.get(minimum_role,99)), and hunk #1 replaces the inline ROLE_RANK comparison inside require_role's wrapper with a call to that helper. The two are inseparable: the helper is only meaningful because the decorator now delegates to it, and the decorator's authorization decision (403 'insufficient role') is the security-relevant behavior being refactored. The comparison logic is semantically identical to the base version (same defaults 0 and 99), so this is a behavior-preserving refactor of the role-based authorization gate that protects manager/admin endpoints (e.g. /admin/*, /orders/all, /users).\",\n      \"hunks\": [\"app/auth.py#0\", \"app/auth.py#1\"],\n      \"context\": [\n        {\"path\": \"app/auth.py\", \"symbol\": \"ROLE_RANK\", \"start_line\": 21, \"end_line\": 21, \"snapshot\": \"pr\", \"why\": \"The role->rank mapping that both the new role_below() helper and the old inline comparison depend on; defines the user<manager<admin hierarchy.\"},\n        {\"path\": \"app/auth.py\", \"symbol\": \"require_role\", \"start_line\": 73, \"end_line\": 89, \"snapshot\": \"pr\", \"why\": \"The decorator whose wrapper (line 82) now calls role_below(); this is the authorization gate that returns 403 for insufficient role.\"},\n        {\"path\": \"app/auth.py\", \"symbol\": \"get_current_user\", \"start_line\": 38, \"end_line\": 47, \"snapshot\": \"pr\", \"why\": \"Provides the user (and user.role) that is passed into the role comparison; the authorization decision depends on this resolved identity.\"},\n        {\"path\": \"app/routes/admin.py\", \"symbol\": \"stats\", \"start_line\": 18, \"end_line\": 29, \"snapshot\": \"pr\", \"why\": \"Representative consumer of @require_role('admin'); shows the refactored gate protects admin-only endpoints per security-policy.md \u00a74.\"},\n        {\"path\": \"app/routes/orders.py\", \"symbol\": \"all_orders\", \"start_line\": 50, \"end_line\": 56, \"snapshot\": \"pr\", \"why\": \"Consumer of @require_role('manager'); demonstrates the manager/admin boundary enforced by the refactored comparison.\"},\n        {\"path\": \"app/routes/users.py\", \"symbol\": \"list_users\", \"start_line\": 19, \"end_line\": 25, \"snapshot\": \"pr\", \"why\": \"Consumer of @require_role('manager'); another endpoint whose access depends on the role_below() logic.\"}\n      ]\n    }\n  ]\n}",
