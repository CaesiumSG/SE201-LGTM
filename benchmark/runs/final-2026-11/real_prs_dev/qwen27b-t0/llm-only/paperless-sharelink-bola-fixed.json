      "finding_id": "plain:authz:1",
      "cwe_id": "CWE-639",
      "explanation": "The change adds a `validate_document` method to `ShareLinkSerializer` that explicitly checks if the current user has `view_document` permission on the provided document object using `has_perms_owner_aware`. This addresses a potential authorization flaw (IDOR) where a user could create a share link for a document they do not have permission to view. The test case confirms that this check is enforced and returns a 403 Forbidden if the permission is missing.",
      "evidence": [
        {
          "type": "code",
          "file": "src/documents/serialisers.py",
          "lines": [
            2183,
            2192
          ],
          "source": null,
          "content": "def validate_document(self, document):\n        if self.user is not None and has_perms_owner_aware(\n            self.user,\n            \"view_document\",\n            document,\n        ):\n            return document\n        raise PermissionDenied(\n            _(\"Insufficient permissions.\"),\n        )",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": true
        }
      ],
