      "finding_id": "plain:authz:1",
      "cwe_id": "CWE-639",
      "explanation": "The change addresses a potential IDOR vulnerability by introducing session binding for `CachedFile` objects. Previously, any authenticated user could potentially access a `CachedFile` if they knew the ID. The new code binds the file to the specific session or API token upon creation (`bind_to_session`) and verifies this binding upon retrieval (`allowed_for_session`). This ensures that only the user who created the file (or the specific API token/device associated with the session) can access it, effectively closing the IDOR gap.",
      "evidence": [
        {
          "type": "code",
          "file": "src/pretix/api/views/exporters.py",
          "lines": [
            77,
            82
          ],
          "source": null,
          "content": "if not cf.allowed_for_session(self.request, \"exporters-api\"):\n    return Response(\n        {'status': 'failed', 'message': 'Unknown file ID or export failed'},\n        status=status.HTTP_410_GONE\n    )",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": true
        },
