          "content": "clauses = []\n    for field, value in request.args.items():\n        clauses.append(f\"{field} = '{value}'\")\n    where = \" AND \".join(clauses) or \"1=1\"\n    session = get_session()\n    rows = session.execute(\n        text(\"SELECT id, username, role FROM users WHERE \" + where)\n    )",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": true
