          "source": null,
          "content": "rows = session.execute(\n        text(f\"SELECT id, username FROM users WHERE username LIKE '%{last_search}%'\")\n    )",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": true
        }
