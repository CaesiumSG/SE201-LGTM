    {
      "finding_id": "plain:authz:1",
      "cwe_id": "CWE-639",
      "explanation": "The `delete_api_key` function previously verified that the `api_key.user_id` matched the provided `user_id` (ownership check). This check has been removed. The API endpoint `delete_api_key_route` now only checks if the user is active (authentication) but does not verify that the user owns the API key they are trying to delete. This allows any authenticated user to delete any API key by ID (IDOR).",
      "evidence": [
        {
          "type": "code",
          "file": "src/backend/base/langflow/services/database/models/api_key/crud.py",
          "lines": [
            44,
            50
          ],
          "source": null,
          "content": "async def delete_api_key(session: AsyncSession, api_key_id: UUID) -> None:\n    api_key = await session.get(ApiKey, api_key_id)\n    if api_key is None:\n        msg = \"API Key not found\"\n        raise ValueError(msg)\n    await session.delete(api_key)",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": false
        },
        {
          "type": "code",
          "file": "src/backend/base/langflow/api/v1/api_key.py",
          "lines": [
            44,
            50
          ],
          "source": null,
          "content": "@router.delete(\"/{api_key_id}\", dependencies=[Depends(auth_utils.get_current_active_user)])\nasync def delete_api_key_route(\n    api_key_id: UUID,\n    db: DbSession,\n):\n    try:\n        await delete_api_key(db, api_key_id)",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": false
        }
      ],
      "suggested_fix": "Restore the ownership check in `delete_api_key` by requiring the `user_id` parameter and verifying `api_key.user_id == user_id` before deletion, or perform the ownership check in the API route layer before calling the CRUD function.",
