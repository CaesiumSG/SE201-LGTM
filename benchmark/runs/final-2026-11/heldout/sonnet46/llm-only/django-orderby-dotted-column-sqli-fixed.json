      "finding_id": "plain:sqli:0",
      "cwe_id": "CWE-89",
      "explanation": "The change adds an ORDER_PATTERN regex check (`[-+]?[.\\w]+$`) to validate ordering strings that contain a dot before they are processed. This restricts the allowed characters to word characters, dots, and leading +/- signs, preventing injection of special characters like semicolons, parentheses, or SQL keywords into raw column alias ordering. The fix is a security improvement that reduces SQLi risk from user-controlled ordering input. The test confirms that a string like 'queries.name);' is now rejected.",
      "evidence": [
        {
          "type": "code",
          "file": "django/db/models/sql/query.py",
          "lines": [
            1974,
            1974
          ],
          "source": null,
          "content": "-                if '.' in item:\n+                if '.' in item and ORDER_PATTERN.match(item):",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": true
        },
