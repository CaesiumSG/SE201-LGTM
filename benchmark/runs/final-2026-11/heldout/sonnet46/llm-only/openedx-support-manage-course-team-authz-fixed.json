      "finding_id": "plain:authz:1",
      "cwe_id": "CWE-862",
      "explanation": "The diff adds a missing authorization gate to the GET handler. Previously any authenticated user could reach the view (only IsAuthenticated was enforced). Now _caller_can_manage_course_team() is called at the start of get(), raising PermissionDenied (HTTP 403) for plain learners. The check correctly covers superuser, staff, SupportStaffRole, and any user with an instructor CourseAccessRole. The tests confirm both existing and non-existing target emails return 403 for plain learners, preventing account enumeration via differential responses.",
      "evidence": [
        {
          "type": "code",
          "file": "lms/djangoapps/support/rest_api/v1/views.py",
          "lines": [
            243,
            249
          ],
          "source": null,
          "content": "        if not self._caller_can_manage_course_team(request.user):\n            raise PermissionDenied(\n                \"You do not have permission to view course team information.\"\n            )\n        return self.list(request, *args, **kwargs)",
          "snapshot": null,
