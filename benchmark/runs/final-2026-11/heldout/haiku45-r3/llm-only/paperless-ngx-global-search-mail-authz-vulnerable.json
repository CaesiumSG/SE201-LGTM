    {
      "finding_id": "plain:authz:3",
      "cwe_id": "CWE-639",
      "explanation": "GlobalSearchView.get filters SavedView by owner=request.user without additional permission checks. While it checks has_perm('view_savedview'), a user could theoretically manipulate the query to search other users' saved views if the filter condition is not sufficient. The code appears to filter by owner which is correct, but the authorization boundary is implicit rather than explicit.",
      "evidence": [
        {
          "type": "code",
          "file": "src/documents/views.py",
          "lines": [
            1160,
            1165
          ],
          "source": null,
          "content": "        saved_views = (\n            SavedView.objects.filter(owner=request.user, name__icontains=query)[\n                :OBJECT_LIMIT\n            ]\n            if request.user.has_perm(\"documents.view_savedview\")\n            else []\n        )",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": true
        }
      ],
      "suggested_fix": "The current implementation appears safe as it filters by owner=request.user, but consider making this explicit: only return saved views where owner==request.user to prevent any IDOR possibility.",
