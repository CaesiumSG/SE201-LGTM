          "lines": [
            66,
            73
          ],
          "source": null,
          "content": "        else:\n            # For rasters, add explicit type cast to WKB string.\n            return \"'%s'::raster\" % self.ewkb",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": true
        }
      ],
      "suggested_fix": "Use psycopg2's binary adapter or proper quoting for raster data instead of string interpolation, e.g., wrap the raster WKB in a Binary object and let psycopg handle quoting, or use parameter placeholders with cursor.execute.",
