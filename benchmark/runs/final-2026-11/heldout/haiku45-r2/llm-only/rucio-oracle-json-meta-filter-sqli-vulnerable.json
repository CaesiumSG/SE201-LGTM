          "source": null,
          "content": "    # replace account and scope in filters with internal representation\n    for or_group in filters:\n        if 'account' in or_group:\n            or_group['account'] = InternalAccount(or_group['account'], vo=vo)\n        if 'scope' in or_group:\n            or_group['account'] = InternalScope(or_group['scope'], vo=vo)",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": true
