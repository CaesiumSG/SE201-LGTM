    {
      "finding_id": "plain:sqli:0",
      "cwe_id": "CWE-89",
      "explanation": "This PR introduces a fix for a previously existing SQL injection vulnerability in savepoint names. The `validate_savepoint_name` function strictly allowlists only alphanumeric characters, hyphens, and underscores. It is called before any f-string interpolation of the savepoint name into SQL commands in both postgres.py and sqlite.py. The fix is applied at creation time (`savepoint()`) and also defensively at usage time (`rollback_to()` and `release()`), preventing injection via user-controlled savepoint names.",
      "evidence": [
        {
          "type": "code",
          "file": "piccolo/engine/base.py",
          "lines": [
            24,
            31
          ],
          "source": null,
          "content": "def validate_savepoint_name(savepoint_name: str) -> None:\n    \"\"\"Validates a save point's name meets the required character set.\"\"\"\n    if not all(i in VALID_SAVEPOINT_CHARACTERS for i in savepoint_name):\n        raise ValueError(\n            \"Savepoint names can only contain the following characters:\"\n            f\" {VALID_SAVEPOINT_CHARACTERS}\"\n        )",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": true
        }
