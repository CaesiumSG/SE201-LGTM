    {
      "finding_id": "plain:authz:1",
      "cwe_id": "CWE-862",
      "explanation": "The diff adds a missing authorization check (_caller_can_manage_course_team) to the GET handler that previously allowed any authenticated user to reach the view. The fix raises PermissionDenied for users who are not superuser, staff, SupportStaffRole, or a course instructor. This addresses the regression described in the test (GHSA-95xv-3c54-c3pw). The logic is consistent between GET and PUT (GET now requires at least what PUT requires). No IDOR pattern is introduced because the target user is looked up only after the caller's permission is validated.",
      "evidence": [
        {
          "type": "code",
          "file": "lms/djangoapps/support/rest_api/v1/views.py",
          "lines": [
            243,
            249
          ],
          "source": null,
          "content": "        if not self._caller_can_manage_course_team(request.user):\n            raise PermissionDenied(\n                \"You do not have permission to view course team information.\"\n            )\n        return self.list(request, *args, **kwargs)",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": true
        }
