    {
      "finding_id": "plain:sqli:0",
      "cwe_id": "CWE-89",
      "explanation": "When handling raster objects, getquoted() builds a SQL literal by directly interpolating self.ewkb into a string ('%s'::raster) without using parameter binding or proper escaping. If an attacker can influence the raster data (e.g., via a crafted upload) and inject a single\u2011quote or other SQL syntax, the resulting query could be altered, leading to SQL injection.",
      "evidence": [
        {
          "type": "code",
          "file": "django/contrib/gis/db/backends/postgis/adapter.py",
          "lines": [
            48,
            58
          ],
          "source": null,
          "content": "        else:\n            # For rasters, add explicit type cast to WKB string.\n            return \"'%s'::raster\" % self.ewkb",
          "snapshot": null,
          "snapshot_conflict": false,
          "grounded_in_pr": true
        }
      ],
      "suggested_fix": "Use a proper Psycopg2 adapter for raster data (e.g., Binary or a custom ISQLQuote implementation) that safely escapes the value, or pass the raster as a query parameter instead of string interpolation.",
