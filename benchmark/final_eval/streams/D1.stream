# Stream D1: gpt-oss-20b on Amazon Bedrock (OpenAI-compatible endpoint) as the reviewer, temperature 0, Kev on GPU job A (8008). Budget cap USD 95 over the whole ledger.
heldout-gptoss20b-bedrock export AWS_BEARER_TOKEN_BEDROCK="$(grep ^AWS_BEDROCK_API_KEY= ../se201-lgtm/.env | cut -d= -f2- | tr -d "\r\"")"; .venv/bin/python benchmark/real_prs/run_real_prs.py --cases-file benchmark/real_prs/heldout.json --bedrock-model openai.gpt-oss-20b-1:0 --bedrock-budget 95 --temperature 0 --modes lgtm llm-only --resume --cache .eval-cache/realprs-M --output benchmark/runs/final-2026-11/heldout/gptoss20b-bedrock
