# Repeat run 2 of gptoss120b-bedrock on the held-out set (half b of the 17 advisories; the two halves ran in parallel to fit the GPU judge's walltime). Same command as run 1 except --cases, --judge-endpoint (Kev on GPU job 355508) and the budget cap, raised to USD 190 with the user's approval (total must stay under 200).
heldout-gptoss120b-bedrock-r2b export AWS_BEARER_TOKEN_BEDROCK="$(grep ^AWS_BEDROCK_API_KEY= ../se201-lgtm/.env | cut -d= -f2- | tr -d "\r\"")"; .venv/bin/python benchmark/real_prs/run_real_prs.py --cases-file benchmark/real_prs/heldout.json --cases django-orderby-dotted-column-sqli alerta-query-string-parser-sqli rucio-postgres-meta-filter-sqli piccolo-savepoint-name-sqli khoj-subscription-email-idor sentry-notification-option-delete-idor plane-bulk-issue-dates-idor readthedocs-team-access-filter-authz --bedrock-model openai.gpt-oss-120b-1:0 --bedrock-budget 190 --temperature 0 --judge-endpoint http://127.0.0.1:8009 --modes lgtm llm-only --resume --cache .eval-cache/rep-gptoss120b-bedrock-r2b --output benchmark/runs/final-2026-11/heldout/gptoss120b-bedrock-r2
