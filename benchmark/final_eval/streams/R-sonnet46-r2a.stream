# Repeat run 2 of sonnet46 on the held-out set (half a of the 17 advisories; the two halves ran in parallel to fit the GPU judge's walltime). Same command as run 1 except --cases, --judge-endpoint (Kev on GPU job 355507) and the budget cap, raised to USD 190 with the user's approval (total must stay under 200).
heldout-sonnet46-r2a export AWS_BEARER_TOKEN_BEDROCK="$(grep ^AWS_BEDROCK_API_KEY= ../se201-lgtm/.env | cut -d= -f2- | tr -d "\r\"")"; .venv/bin/python benchmark/real_prs/run_real_prs.py --cases-file benchmark/real_prs/heldout.json --cases django-raster-band-index-sqli ormar-aggregate-minmax-sqli taiga-epic-order-sqli rucio-oracle-json-meta-filter-sqli django-cms-structure-endpoint-authz sentry-rule-snooze-idor authentik-ssf-stream-authz openedx-support-manage-course-team-authz paperless-ngx-global-search-mail-authz --bedrock-model global.anthropic.claude-sonnet-4-6 --bedrock-budget 190 --judge-endpoint http://127.0.0.1:8008 --modes lgtm llm-only --resume --cache .eval-cache/rep-sonnet46-r2a --output benchmark/runs/final-2026-11/heldout/sonnet46-r2
