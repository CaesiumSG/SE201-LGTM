# Stream A: GPU job A (Qwen 11435, Kev 8008). Benchmarks brought up to date, then the temperature sweep.
shoply-lgtm .venv/bin/python benchmark/evaluate.py --gpu-model qwen3.8-27b --mode lgtm --split all --resume --output benchmark/runs/final-2026-11/shoply/lgtm
shoply-llm-only .venv/bin/python benchmark/evaluate.py --gpu-model qwen3.8-27b --mode llm-only --split all --resume --output benchmark/runs/final-2026-11/shoply/llm-only
