field-trial .venv/bin/python benchmark/field_trial/run_field_trial.py --gpu-model qwen3.8-27b --modes lgtm llm-only --resume --cache .eval-cache/fieldtrial-A --output benchmark/runs/final-2026-11/field_trial
realprs-dev .venv/bin/python benchmark/real_prs/run_real_prs.py --gpu-model qwen3.8-27b --modes lgtm llm-only sast-only --resume --cache .eval-cache/realprs-A --output benchmark/runs/final-2026-11/real_prs_dev/qwen27b-t0
