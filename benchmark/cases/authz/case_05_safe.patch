+@admin_bp.route("/export", methods=["GET"])
+@require_role("admin")
+def export_data():
+    """Export all users and orders as JSON (admin reporting)."""
+    session = get_session()
+    return jsonify(
+        {
+            "users": [u.to_dict(include_email=True) for u in session.query(User).all()],
+            "orders": [o.to_dict() for o in session.query(Order).all()],
+        }
+    )
