+@users_bp.route("/<int:user_id>", methods=["DELETE"])
+@require_role("admin")
+def delete_user(user_id: int):
+    """Delete a user account. Admins only."""
+    session = get_session()
+    user = session.get(User, user_id)
+    if user is None:
+        return jsonify({"error": "not found"}), 404
+    session.delete(user)
+    session.commit()
+    return jsonify({"status": "deleted"})
